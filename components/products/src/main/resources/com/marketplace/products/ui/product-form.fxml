<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.marketplace.products.ui.ProductFormController"
            stylesheets="@application.css" styleClass="app-root" prefWidth="940" prefHeight="740">

    <top>
        <VBox styleClass="form-header" spacing="2">
            <Label fx:id="titleLabel" styleClass="form-title"/>
            <Label fx:id="idLabel" styleClass="muted-text"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll">
            <HBox spacing="30">
                <padding>
                    <Insets top="22" right="26" bottom="22" left="26"/>
                </padding>

                <!-- Left column: the product's details -->
                <VBox spacing="16" HBox.hgrow="ALWAYS" prefWidth="470">
                    <VBox spacing="4">
                        <Label text="NAME *" styleClass="field-caption"/>
                        <TextField fx:id="nameField" promptText="e.g. Ergonomic Desk Lamp"/>
                        <Label fx:id="nameError" styleClass="error-label" visible="false" managed="false"
                               wrapText="true"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="DESCRIPTION" styleClass="field-caption"/>
                        <TextArea fx:id="descriptionArea" prefRowCount="4" wrapText="true"
                                  promptText="Optional: what is this product?"/>
                        <Label fx:id="descriptionError" styleClass="error-label" visible="false" managed="false"
                               wrapText="true"/>
                    </VBox>

                    <HBox spacing="14">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="PRICE (£) *" styleClass="field-caption"/>
                            <TextField fx:id="priceField" promptText="e.g. 19.99"/>
                            <Label fx:id="priceError" styleClass="error-label" visible="false" managed="false"
                                   wrapText="true"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="STOCK QUANTITY *" styleClass="field-caption"/>
                            <TextField fx:id="stockField" promptText="whole number, e.g. 25"/>
                            <Label fx:id="stockError" styleClass="error-label" visible="false" managed="false"
                                   wrapText="true"/>
                        </VBox>
                    </HBox>

                    <CheckBox fx:id="activeCheck" text="Active (shown in the catalogue and available for sale)"/>

                    <VBox spacing="6">
                        <Label text="CATEGORIES * (choose one or more)" styleClass="field-caption"/>
                        <FlowPane fx:id="categoryBox" hgap="14" vgap="8" styleClass="category-box"/>
                        <HBox spacing="8">
                            <TextField fx:id="newCategoryField" promptText="Add a new category..."
                                       onAction="#onAddCategory" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="addCategoryButton" text="Add category" onAction="#onAddCategory"
                                    styleClass="secondary-button"/>
                        </HBox>
                        <Label fx:id="categoriesError" styleClass="error-label" visible="false" managed="false"
                               wrapText="true"/>
                    </VBox>
                </VBox>

                <!-- Right column: images -->
                <VBox spacing="10" prefWidth="360" minWidth="340">
                    <Label text="IMAGES" styleClass="field-caption"/>
                    <StackPane fx:id="previewHolder" alignment="CENTER"/>
                    <FlowPane fx:id="thumbnailStrip" hgap="8" vgap="8"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="addImagesButton" text="Add images..." onAction="#onAddImages"
                                styleClass="secondary-button"/>
                        <Label fx:id="imageCountLabel" styleClass="muted-text"/>
                    </HBox>
                    <Label text="PNG, JPG, GIF or BMP, up to 5 MB each. The first image is the catalogue thumbnail. Click a thumbnail to preview it; use X to remove it."
                           styleClass="muted-text" wrapText="true"/>
                    <Label fx:id="imagesError" styleClass="error-label" visible="false" managed="false"
                           wrapText="true"/>
                </VBox>
            </HBox>
        </ScrollPane>
    </center>

    <bottom>
        <VBox styleClass="form-footer" spacing="8">
            <Label fx:id="formError" styleClass="error-banner" visible="false" managed="false" wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <ProgressIndicator fx:id="busyIndicator" prefWidth="20" prefHeight="20" visible="false"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel" cancelButton="true"
                        styleClass="secondary-button"/>
                <Button fx:id="saveButton" text="Save product" onAction="#onSave" defaultButton="true"
                        styleClass="primary-button"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
