<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.marketplace.products.ui.MainController"
            stylesheets="@application.css" styleClass="app-root" prefWidth="1360" prefHeight="840">

    <top>
        <VBox>
            <!-- Title bar: database status, refresh, add -->
            <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="2">
                    <Label text="Product Catalogue" styleClass="app-title"/>
                    <Label text="Marketplace back office  |  Products component" styleClass="app-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="dbStatusLabel" styleClass="db-status"/>
                <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh" styleClass="header-button"/>
                <Button fx:id="addButton" text="+ Add product" onAction="#onAddProduct" styleClass="add-button"/>
            </HBox>

            <!-- Search and filters: all combined with AND -->
            <VBox styleClass="filter-bar" spacing="6">
                <HBox spacing="12" alignment="BOTTOM_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="SEARCH BY NAME" styleClass="field-caption"/>
                        <TextField fx:id="searchField" promptText="Type part of a product name..."/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="CATEGORY" styleClass="field-caption"/>
                        <ComboBox fx:id="categoryCombo" prefWidth="190"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="MIN PRICE (£)" styleClass="field-caption"/>
                        <TextField fx:id="minPriceField" prefWidth="95" promptText="0"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="MAX PRICE (£)" styleClass="field-caption"/>
                        <TextField fx:id="maxPriceField" prefWidth="95" promptText="any"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="AVAILABILITY" styleClass="field-caption"/>
                        <ComboBox fx:id="availabilityCombo" prefWidth="170"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="STATUS" styleClass="field-caption"/>
                        <ComboBox fx:id="statusCombo" prefWidth="170"/>
                    </VBox>
                    <Button fx:id="resetButton" text="Reset filters" onAction="#onResetFilters"
                            styleClass="secondary-button"/>
                </HBox>
                <Label fx:id="priceFilterError" styleClass="error-label" visible="false" managed="false"/>
            </VBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.68" styleClass="main-split">
            <!-- Catalogue table with loading / empty / no-match / error states layered on top -->
            <StackPane styleClass="card">
                <TableView fx:id="productTable">
                    <columns>
                        <TableColumn fx:id="imageColumn" text="" prefWidth="80" minWidth="80" maxWidth="80"
                                     resizable="false"/>
                        <TableColumn fx:id="nameColumn" text="PRODUCT" prefWidth="270" minWidth="160"/>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="90" minWidth="80"/>
                        <TableColumn fx:id="categoriesColumn" text="CATEGORIES" prefWidth="150" minWidth="100"/>
                        <TableColumn fx:id="priceColumn" text="PRICE" prefWidth="90" minWidth="75"/>
                        <TableColumn fx:id="stockColumn" text="STOCK" prefWidth="115" minWidth="95"/>
                        <TableColumn fx:id="statusColumn" text="STATUS" prefWidth="85" minWidth="75"/>
                    </columns>
                </TableView>

                <VBox fx:id="loadingBox" styleClass="state-box" alignment="CENTER" spacing="12" visible="false"
                      managed="false">
                    <ProgressIndicator prefWidth="42" prefHeight="42"/>
                    <Label text="Loading products..." styleClass="state-text"/>
                </VBox>

                <VBox fx:id="emptyBox" styleClass="state-box" alignment="CENTER" spacing="10" visible="false"
                      managed="false">
                    <Label fx:id="emptyTitle" styleClass="state-title"/>
                    <Label fx:id="emptyMessage" styleClass="state-text" wrapText="true" maxWidth="380"/>
                    <Button fx:id="emptyResetButton" text="Reset filters" onAction="#onResetFilters"
                            styleClass="secondary-button"/>
                </VBox>

                <VBox fx:id="errorBox" styleClass="state-box" alignment="CENTER" spacing="10" visible="false"
                      managed="false">
                    <Label text="Database problem" styleClass="state-title, error-title"/>
                    <Label fx:id="errorMessage" styleClass="state-text" wrapText="true" maxWidth="440"/>
                    <Button fx:id="retryButton" text="Retry connection" onAction="#onRetry"
                            styleClass="primary-button"/>
                </VBox>
            </StackPane>

            <!-- Details of the selected product -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="card, details-scroll" minWidth="340">
                <StackPane>
                    <VBox fx:id="detailsPlaceholder" styleClass="state-box" alignment="CENTER" spacing="8">
                        <Label text="Select a product" styleClass="state-title"/>
                        <Label text="Choose a row in the table to see its images, details and actions."
                               styleClass="state-text" wrapText="true" maxWidth="280"/>
                    </VBox>

                    <VBox fx:id="detailsContent" spacing="14">
                        <padding>
                            <Insets top="18" right="18" bottom="18" left="18"/>
                        </padding>
                        <StackPane fx:id="mainImageHolder" alignment="CENTER"/>
                        <FlowPane fx:id="thumbnailStrip" hgap="8" vgap="8"/>

                        <VBox spacing="3">
                            <Label fx:id="detailName" styleClass="detail-name" wrapText="true"/>
                            <Label fx:id="detailId" styleClass="id-label"/>
                        </VBox>

                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label fx:id="detailPrice" styleClass="detail-price"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="detailStatusBadge"/>
                            <Label fx:id="detailStockBadge"/>
                        </HBox>

                        <FlowPane fx:id="detailCategories" hgap="6" vgap="6"/>
                        <Label fx:id="detailDescription" styleClass="detail-description" wrapText="true"/>
                        <Label fx:id="detailDates" styleClass="muted-text" wrapText="true"/>

                        <HBox spacing="8">
                            <Button fx:id="editButton" text="Edit" onAction="#onEditProduct"
                                    styleClass="primary-button"/>
                            <Button fx:id="toggleActiveButton" onAction="#onToggleActive"
                                    styleClass="secondary-button"/>
                            <Button fx:id="deleteButton" text="Delete" onAction="#onDeleteProduct"
                                    styleClass="danger-button"/>
                        </HBox>
                    </VBox>
                </StackPane>
            </ScrollPane>
        </SplitPane>
    </center>

    <!-- Status bar: success / error messages on the left, catalogue summary on the right -->
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="10">
            <ProgressIndicator fx:id="busyIndicator" prefWidth="16" prefHeight="16" visible="false"/>
            <Label fx:id="statusMessage"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="summaryLabel" styleClass="muted-text"/>
        </HBox>
    </bottom>
</BorderPane>
